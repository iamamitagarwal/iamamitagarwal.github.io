---
layout: null
permalink: /publications.json
sitemap: false
---
{
  "schema_version": 1,
  "description": "Publication metadata and abstracts as recorded on this site; summaries are labeled separately. Venue status follows the record, not the hosting domain of the paper link.",
  "publications": [
  {%- assign papers = site.publications | sort: 'title' | sort: 'year' | reverse -%}
  {%- for paper in papers -%}
    {%- assign venue_key = paper.venue | downcase -%}
    {%- assign status = 'published' -%}
    {%- if venue_key contains 'arxiv' or paper.venue_token == 'arxiv' -%}
      {%- assign status = 'preprint' -%}
    {%- elsif venue_key contains '(accepted)' -%}
      {%- assign status = 'accepted' -%}
    {%- elsif venue_key == 'under review' -%}
      {%- assign status = 'under_review' -%}
    {%- elsif venue_key == 'ljmu' or venue_key == '' -%}
      {%- assign status = 'unspecified' -%}
    {%- endif -%}
    {%- assign authors = '' | split: '' -%}
    {%- assign raw_authors = paper.authors | split: ',' -%}
    {%- for author in raw_authors -%}
      {%- assign name = author | strip -%}
      {%- assign authors = authors | push: name -%}
    {%- endfor -%}
    {%- assign rendered_content = paper.content | markdownify -%}
    {%- assign abstract = nil -%}
    {%- assign summary = nil -%}
    {%- assign paragraphs = rendered_content | split: '</p>' -%}
    {%- for paragraph in paragraphs -%}
      {%- if paragraph contains '<strong>Abstract.</strong>' -%}
        {%- assign abstract = paragraph | split: '<strong>Abstract.</strong>' | last | strip_html | replace: '&amp;', '&' | strip -%}
      {%- elsif paragraph contains '<strong>Summary.</strong>' -%}
        {%- assign summary = paragraph | split: '<strong>Summary.</strong>' | last | strip_html | replace: '&amp;', '&' | strip -%}
      {%- endif -%}
    {%- endfor -%}
    {
      "title": {{ paper.title | jsonify }},
      "authors": {{ authors | jsonify }},
      "year": {{ paper.year | jsonify }},
      "venue": {{ paper.venue | jsonify }},
      "status": {{ status | jsonify }},
      "url": {{ paper.url | absolute_url | jsonify }},
      "paper_url": {{ paper.paper_url | jsonify }},
      "pdf_url": {{ paper.pdf_url | jsonify }},
      "topics": {{ paper.tags | jsonify }},
      "keywords": {{ paper.keywords | jsonify }},
      "abstract": {{ abstract | jsonify }},
      "summary": {{ summary | jsonify }},
      "record_text": {{ rendered_content | strip_html | replace: '&amp;', '&' | strip | jsonify }},
      "recognition": {{ paper.recognition | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
  ]
}
